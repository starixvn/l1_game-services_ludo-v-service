{
  "name": "ludo-v-service",
  "version": "1.0.0",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "reg": "npm set registry http://npm.lumigame.com",
    "test": "jest --testPathPatterns=tests/unit-test/",
    "test-coverage": "jest --collect-coverage --testPathPatterns=tests/unit-test/",
    "test-integration": "jest --config=jest.integration.config.cjs --testPathPatterns=tests/integration-test/ludo.test.ts",
    "start": "node --max-old-space-size=8192 --import=extensionless/register ./dist/app.js",
    "simulation": "tsx tests/simulation/run-simulation.ts -r 100000 -m 0.04 -s random"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@swc/core": "^1.15.3",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/sc-common": "^1.0.2",
    "@types/sc-game-service-integration-utils": "^1.0.0",
    "jest": "^30.2.0",
    "jest-sonar-reporter": "^2.0.0",
    "sc-game-service-integration-utils": "^2.3.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@rd/ludo-rules": "1.0.1-beta.10",
    "extensionless": "^2.0.2",
    "mongoose": "6.13.8",
    "sc-common": "^3.0.0",
    "sc-core-rng": "^1.1.0",
    "sc-game-base": "6.3.2-beta.1"
  }
}
